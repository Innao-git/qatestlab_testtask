BASE_URL=https://opensource-demo.orangehrmlive.com
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Optional: API request logging (see README → "Inspecting API requests") ---
# Print every API request/response to the console (they are always attached to the HTML report).
# API_LOG=1
# Show the real "orangehrm" session cookie instead of "***" (passwords and CSRF tokens stay masked).
# For local debugging only: reports made with it contain a live session - do not share them or enable it in CI.
# API_LOG_SHOW_SESSION=1
